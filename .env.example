DATABASE_URL=
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:4000
AUTH_SECRET=
SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by `npm run admin:create`
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Local development: lax. For unrelated HTTPS domains (such as Vercel + Render), use none.
# Same-site production deployments can use lax with COOKIE_DOMAIN=.example.com.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Email (password reset). If unset, reset links are only logged outside production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SWAGGER_ENABLED=true
